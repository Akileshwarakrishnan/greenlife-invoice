# =================================================================
# GreenLife Natural Foods — AI Automated Invoice System Configuration
# =================================================================

# Server & Environment
ENVIRONMENT=development
PORT=8000

# Database Configuration (PostgreSQL for production; auto-falls back to SQLite locally)
DATABASE_URL=postgresql://greenlife:greenlife123@localhost:5432/greenlife_db

# Security & JWT Authentication
JWT_SECRET=replace-with-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# n8n Workflow Automation Layer
N8N_WEBHOOK_URL=http://localhost:5678/webhook/order-processing
N8N_EMAIL_WEBHOOK_URL=http://localhost:5678/webhook/email-invoice
N8N_WHATSAPP_WEBHOOK_URL=http://localhost:5678/webhook/whatsapp-notification
N8N_AI_WEBHOOK_URL=http://localhost:5678/webhook/ai-extraction
N8N_API_URL=http://localhost:5678/api/v1
N8N_API_KEY=
N8N_MOCK_FALLBACK=true

# AI Provider Configuration (OpenAI, Ollama, LM Studio, or local compatible API)
AI_PROVIDER=openai
AI_API_KEY=your-openai-or-custom-api-key-here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=invoices@greenlife.com
SMTP_PASSWORD=your-email-app-password
SMTP_FROM_EMAIL=invoices@greenlife.com

# WhatsApp Business / Cloud API
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_API_KEY=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# File Storage Configuration (local or s3)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=greenlife-invoices
